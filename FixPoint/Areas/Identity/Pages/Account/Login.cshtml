@page
@model FixPoint.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center" style="min-height:70vh;">
    <div class="col-md-5 col-lg-4">

        <div class="text-center mb-4">
            <div style="width:56px;height:56px;background:#111827;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <i class="bi bi-tools" style="font-size:1.5rem;color:#f59e0b;"></i>
            </div>
            <h2 style="font-weight:700;font-size:1.6rem;">Welcome back</h2>
            <p class="text-muted" style="font-size:0.9rem;">Sign in to your FixPoint account</p>
        </div>

        <div class="fp-form-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert mb-3"
                     style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;color:#b91c1c;font-size:0.88rem;"></div>

                <div class="mb-3">
                    <label class="fp-form-label">
                        <i class="bi bi-envelope me-1"></i> Email Address
                    </label>
                    <input asp-for="Input.Email"
                           class="fp-input form-control"
                           placeholder="you@email.com"
                           autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="fp-form-label mb-0">
                            <i class="bi bi-lock me-1"></i> Password
                        </label>
                    </div>
                    <input asp-for="Input.Password"
                           class="fp-input form-control"
                           placeholder="Your password"
                           autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="mb-4 d-flex align-items-center gap-2">
                    <input asp-for="Input.RememberMe"
                           class="form-check-input mt-0"
                           style="width:16px;height:16px;border-radius:4px;" />
                    <label asp-for="Input.RememberMe"
                           style="font-size:0.88rem;color:#6b7280;cursor:pointer;">
                        Keep me signed in
                    </label>
                </div>

                <button type="submit" class="btn btn-fp-primary w-100 py-2" style="font-size:0.95rem;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>
        </div>

        <p class="text-center mt-4" style="font-size:0.88rem;color:#6b7280;">
            Don't have an account?
            <a asp-page="/Account/Register"
               style="color:#f59e0b;font-weight:600;text-decoration:none;">
                Create one here
            </a>
        </p>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}