@page
@model FixPoint.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center" style="min-height:70vh;">
    <div class="col-md-6 col-lg-5">

        <div class="text-center mb-4">
            <div style="width:56px;height:56px;background:#111827;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <i class="bi bi-person-plus" style="font-size:1.5rem;color:#f59e0b;"></i>
            </div>
            <h2 style="font-weight:700;font-size:1.6rem;">Create an account</h2>
            <p class="text-muted" style="font-size:0.9rem;">Join FixPoint to start managing facility requests</p>
        </div>

        <div class="fp-form-card">
            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert mb-3"
                     style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;color:#b91c1c;font-size:0.88rem;"></div>

                <div class="mb-3">
                    <label class="fp-form-label">
                        <i class="bi bi-person me-1"></i> Full Name
                    </label>
                    <input asp-for="Input.FullName"
                           class="fp-input form-control"
                           placeholder="e.g. Juan Dela Cruz" />
                    <span asp-validation-for="Input.FullName" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <label class="fp-form-label">
                        <i class="bi bi-envelope me-1"></i> Email Address
                    </label>
                    <input asp-for="Input.Email"
                           class="fp-input form-control"
                           placeholder="you@email.com"
                           autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="fp-form-label">
                            <i class="bi bi-lock me-1"></i> Password
                        </label>
                        <input asp-for="Input.Password"
                               class="fp-input form-control"
                               placeholder="Min. 6 characters"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fp-form-label">
                            <i class="bi bi-lock-fill me-1"></i> Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword"
                               class="fp-input form-control"
                               placeholder="Repeat password"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                </div>

                <div class="mb-4 p-3"
                     style="background:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;">
                    <p style="font-size:0.8rem;color:#6b7280;margin:0;">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Password must be at least <strong>6 characters</strong> and include
                        uppercase, lowercase, a number, and a special character.
                    </p>
                </div>

                <button type="submit" class="btn btn-fp-primary w-100 py-2" style="font-size:0.95rem;">
                    <i class="bi bi-person-check me-2"></i>Create Account
                </button>
            </form>
        </div>

        <p class="text-center mt-4" style="font-size:0.88rem;color:#6b7280;">
            Already have an account?
            <a asp-page="/Account/Login"
               style="color:#f59e0b;font-weight:600;text-decoration:none;">
                Sign in here
            </a>
        </p>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}