@model FixPoint.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Request Details";

    var sClass = Model.Status == FixPoint.Models.RequestStatus.Open ? "badge-open" :
                 Model.Status == FixPoint.Models.RequestStatus.InProgress ? "badge-inprogress" :
                 Model.Status == FixPoint.Models.RequestStatus.Resolved ? "badge-resolved" : "badge-closed";

    var pClass = Model.Priority == FixPoint.Models.PriorityLevel.Critical ? "badge-critical" :
                 Model.Priority == FixPoint.Models.PriorityLevel.High ? "badge-high" :
                 Model.Priority == FixPoint.Models.PriorityLevel.Medium ? "badge-medium" : "badge-low";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-clipboard2-pulse text-warning me-2"></i>
                Request #@Model.Id
            </h3>
            <div class="text-muted">
                @Model.Facility?.Name — @Model.Facility?.Location
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="MaintenanceRequest"
                   asp-action="Assign"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-person-check me-1"></i> Assign
                </a>
            }

            <a asp-controller="MaintenanceRequest"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                Back
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- LEFT COLUMN -->
        <div class="col-lg-8">

            <!-- MAIN INFO CARD -->
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-semibold">@Model.Title</h5>

                        <div class="d-flex gap-2">
                            <span class="fp-badge @pClass">@Model.Priority</span>
                            <span class="fp-badge @sClass">@Model.Status</span>
                        </div>
                    </div>

                    <hr />

                    <p class="text-uppercase text-muted small mb-1">Description</p>
                    <p class="mb-4 text-dark" style="white-space:pre-line;">
                        @Model.Description
                    </p>

                    <div class="row">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Reported By</p>
                            <p class="mb-0 fw-medium">@Model.ReportedBy?.FullName</p>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Date Submitted</p>
                            <p class="mb-0 fw-medium">
                                @Model.CreatedAt.ToString("MMMM dd, yyyy")
                            </p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- TECHNICIAN FEEDBACK -->
            @if (Model.Assignment != null &&
                        !string.IsNullOrEmpty(Model.Assignment.FeedbackNotes))
            {
                <div class="card shadow-sm border-0 mt-4 border-start border-success border-4">
                    <div class="card-body">

                        <h6 class="fw-semibold text-success mb-3">
                            <i class="bi bi-chat-left-text me-1"></i>
                            Technician Feedback
                        </h6>

                        <p class="mb-3" style="white-space:pre-line;">
                            @Model.Assignment.FeedbackNotes
                        </p>

                        @if (!string.IsNullOrEmpty(Model.Assignment.ProofPhotoPath))
                        {
                            <img src="@Model.Assignment.ProofPhotoPath"
                                 class="img-fluid rounded border" />
                        }

                        @if (Model.Assignment.FeedbackSubmittedAt != null)
                        {
                            <div class="text-muted small mt-3">
                                Submitted:
                                @Model.Assignment.FeedbackSubmittedAt?.ToString("MMM dd, yyyy - hh:mm tt")
                            </div>
                        }

                    </div>
                </div>
            }

        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-lg-4">

            @if (Model.Assignment != null)
            {
                <div class="card shadow-sm border-0 border-start border-warning border-4">
                    <div class="card-body">

                        <h6 class="fw-semibold text-warning mb-3">
                            <i class="bi bi-person-gear me-1"></i>
                            Assignment
                        </h6>

                        <p class="mb-1 fw-medium">
                            @Model.Assignment.Technician?.FullName
                        </p>

                        <p class="text-muted small">
                            Assigned on @Model.Assignment.AssignedAt.ToString("MMM dd, yyyy")
                        </p>

                        @if (!string.IsNullOrEmpty(Model.Assignment.Notes))
                        {
                            <hr />
                            <p class="mb-0">
                                @Model.Assignment.Notes
                            </p>
                        }

                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 text-center p-4">
                    <i class="bi bi-person-dash display-6 text-muted mb-2"></i>
                    <div class="text-muted">No technician assigned yet</div>
                </div>
            }

        </div>

    </div>
</div>