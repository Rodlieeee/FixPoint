@model FixPoint.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Assign Technician";
}

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title"><i class="bi bi-person-check me-2 text-warning"></i>Assign Technician</h1>
        <p class="fp-page-subtitle">Request #@Model.Id — @Model.Title</p>
    </div>
    <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-fp-outline">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="fp-form-card">

            <div class="p-3 mb-4 rounded-3 d-flex gap-3 align-items-center"
                 style="background:#f9fafb;border:1px solid #e5e7eb;">
                <div style="width:42px;height:42px;background:#fffbeb;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-building" style="color:#f59e0b;font-size:1.1rem;"></i>
                </div>
                <div>
                    <p style="margin:0;font-weight:600;font-size:0.9rem;">@Model.Title</p>
                    <p style="margin:0;font-size:0.82rem;color:#6b7280;">@Model.Facility?.Name</p>
                </div>
            </div>

            <form asp-controller="MaintenanceRequest" asp-action="Assign"
                  asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="fp-form-label">
                        <i class="bi bi-person-gear me-1"></i> Select Technician
                    </label>
                    <select name="technicianId" class="fp-input form-select" required>
                        <option value="">— Choose a technician —</option>
                        @foreach (var item in (SelectList)ViewBag.Technicians)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="fp-form-label">
                        <i class="bi bi-chat-left-text me-1"></i> Notes
                        <span style="color:#9ca3af;font-weight:400;">(optional)</span>
                    </label>
                    <textarea name="notes" class="fp-input form-control" rows="3"
                              placeholder="Any special instructions for the technician..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-fp-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>Confirm Assignment
                    </button>
                    <a asp-controller="MaintenanceRequest" asp-action="Index"
                       class="btn btn-fp-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>