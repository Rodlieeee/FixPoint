@model IEnumerable<FixPoint.Models.MaintenanceRequest>
@{ViewData["Title"] = "Maintenance Requests";}

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title"><i class="bi bi-clipboard-check me-2 text-warning"></i>Requests</h1>
        <p class="fp-page-subtitle">All maintenance requests submitted across facilities</p>
    </div>
    <a asp-controller="MaintenanceRequest" asp-action="Create" class="btn btn-fp-primary">
        <i class="bi bi-plus-circle me-2"></i>New Request
    </a>
</div>

<div class="fp-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Facility</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox display-5 d-block mb-2"></i>
                        No requests found. <a asp-controller="MaintenanceRequest" asp-action="Create">Submit one now</a>
                    </td>
                </tr>
            }
            @foreach (var r in Model)
            {
                var pClass = r.Priority == FixPoint.Models.PriorityLevel.Critical ? "badge-critical" :
                r.Priority == FixPoint.Models.PriorityLevel.High ? "badge-high" :
                r.Priority == FixPoint.Models.PriorityLevel.Medium ? "badge-medium" : "badge-low";

                var sClass = r.Status == FixPoint.Models.RequestStatus.Open ? "badge-open" :
                r.Status == FixPoint.Models.RequestStatus.InProgress ? "badge-inprogress" :
                r.Status == FixPoint.Models.RequestStatus.Resolved ? "badge-resolved" : "badge-closed";

                <tr>
                    <td style="color:#9ca3af;font-size:0.8rem;">#@r.Id</td>

                    <td style="font-weight:500;">@r.Title</td>

                    <td>
                        <span style="display:flex;align-items:center;gap:6px;">
                            <i class="bi bi-building text-muted" style="font-size:0.85rem;"></i>
                            @r.Facility?.Name
                        </span>
                    </td>

                    <td>
                        <span class="fp-badge @pClass">@r.Priority</span>
                    </td>

                    <td>
                        <span class="fp-badge @sClass">@r.Status</span>
                    </td>

                    <td style="color:#6b7280;font-size:0.85rem;">
                        @r.CreatedAt.ToString("MMM dd, yyyy")
                    </td>

                    <td>
                        <div class="d-flex gap-1">

                            <a asp-controller="MaintenanceRequest"
                               asp-action="Details"
                               asp-route-id="@r.Id"
                               class="btn btn-sm btn-fp-outline"
                               title="View">
                                <i class="bi bi-eye"></i>
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="MaintenanceRequest"
                                   asp-action="Assign"
                                   asp-route-id="@r.Id"
                                   class="btn btn-sm btn-fp-outline"
                                   title="Assign">
                                    <i class="bi bi-person-check"></i>
                                </a>
                            }

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>