@model IEnumerable<FixPoint.Models.MaintenanceRequest>
@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title">
            <i class="bi bi-clipboard-check me-2 text-warning"></i>Requests
        </h1>
        <p class="fp-page-subtitle">
            All active maintenance requests across facilities
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="MaintenanceRequest"
           asp-action="History"
           class="btn btn-fp-outline">
            <i class="bi bi-clock-history me-1"></i>History
        </a>

        @if (!User.IsInRole("Admin") && !User.IsInRole("Technician"))
        {
            <a asp-controller="MaintenanceRequest"
               asp-action="Create"
               class="btn btn-fp-primary">
                <i class="bi bi-plus-circle me-2"></i>New Request
            </a>
        }
    </div>
</div>

<div class="fp-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Facility</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox display-5 d-block mb-2"></i>
                        No active requests found.

                        @if (!User.IsInRole("Admin") && !User.IsInRole("Technician"))
                        {
                            <a asp-controller="MaintenanceRequest"
                               asp-action="Create"
                               style="color:#f59e0b;font-weight:600;">
                                Submit one now
                            </a>
                        }
                    </td>
                </tr>
            }

            @foreach (var r in Model)
            {
                var pClass =
                r.Priority == FixPoint.Models.PriorityLevel.Critical ? "badge-critical" :
                r.Priority == FixPoint.Models.PriorityLevel.High ? "badge-high" :
                r.Priority == FixPoint.Models.PriorityLevel.Medium ? "badge-medium" :
                "badge-low";

                var sClass =
                r.Status == FixPoint.Models.RequestStatus.Open ? "badge-open" :
                r.Status == FixPoint.Models.RequestStatus.InProgress ? "badge-inprogress" :
                r.Status == FixPoint.Models.RequestStatus.Resolved ? "badge-resolved" :
                "badge-closed";

                var currentUserId = User
                .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                var isMine = r.Assignment?.TechnicianId == currentUserId;

                var canFeedback = User.IsInRole("Technician")
                && r.Assignment != null
                && isMine
                && r.Status != FixPoint.Models.RequestStatus.Resolved
                && r.Status != FixPoint.Models.RequestStatus.Closed;

                <tr>
                    <td style="color:#9ca3af;font-size:0.8rem;">#@r.Id</td>

                    <td style="font-weight:500;">@r.Title</td>

                    <td>
                        <span style="display:flex;align-items:center;gap:6px;">
                            <i class="bi bi-building text-muted"
                               style="font-size:0.85rem;"></i>
                            @r.Facility?.Name
                        </span>
                    </td>

                    <td>
                        <span class="fp-badge @pClass">@r.Priority</span>
                    </td>

                    <td>
                        <span class="fp-badge @sClass">@r.Status</span>
                    </td>

                    <td>
                        @if (r.Assignment?.Technician != null)
                        {
                            <div style="display:flex;align-items:center;gap:6px;">
                                <div style="width:26px;height:26px;border-radius:50%;
                                                            background:#fffbeb;display:flex;
                                                            align-items:center;justify-content:center;
                                                            font-size:0.7rem;font-weight:600;color:#b45309;">
                                    @r.Assignment.Technician.FullName[0].ToString().ToUpper()
                                </div>
                                <span style="font-size:0.85rem;">
                                    @r.Assignment.Technician.FullName
                                </span>
                            </div>
                        }
                        else
                        {
                            <span style="font-size:0.82rem;color:#9ca3af;">
                                <i class="bi bi-dash"></i> Unassigned
                            </span>
                        }
                    </td>

                    <td style="color:#6b7280;font-size:0.85rem;">
                        @r.CreatedAt.ToString("MMM dd, yyyy")
                    </td>

                    <td>
                        <div class="d-flex gap-1 align-items-center">

                            <a asp-controller="MaintenanceRequest"
                               asp-action="Details"
                               asp-route-id="@r.Id"
                               class="btn btn-sm btn-fp-outline"
                               title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="MaintenanceRequest"
                                   asp-action="Assign"
                                   asp-route-id="@r.Id"
                                   class="btn btn-sm btn-fp-outline"
                                   title="Assign Technician">
                                    <i class="bi bi-person-check"></i>
                                </a>
                            }

                            @if (canFeedback)
                            {
                                <a asp-controller="MaintenanceRequest"
                                   asp-action="SubmitFeedback"
                                   asp-route-id="@r.Id"
                                   class="btn btn-sm btn-fp-primary"
                                   title="Submit Feedback">
                                    <i class="bi bi-chat-left-text"></i>
                                </a>
                            }

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>