@model FixPoint.Models.Facility
@{
    ViewData["Title"] = "Delete Facility";
}

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title" style="color:#ef4444;">
            <i class="bi bi-trash me-2"></i>Delete Facility
        </h1>
        <p class="fp-page-subtitle">This action cannot be undone</p>
    </div>
    <a asp-controller="Facility" asp-action="Index" class="btn btn-fp-outline">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="fp-form-card">

            <div class="p-3 mb-4 rounded-3 d-flex gap-3 align-items-center"
                 style="background:#fef2f2;border:1px solid #fecaca;">
                <div style="width:44px;height:44px;background:#fee2e2;border-radius:10px;
                            display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-exclamation-triangle"
                       style="font-size:1.2rem;color:#ef4444;"></i>
                </div>
                <div>
                    <p style="margin:0;font-weight:600;color:#b91c1c;font-size:0.95rem;">
                        Are you sure you want to delete this facility?
                    </p>
                    <p style="margin:0;font-size:0.82rem;color:#ef4444;">
                        All associated maintenance requests may be affected.
                    </p>
                </div>
            </div>

            <div class="mb-4 p-3"
                 style="background:#f9fafb;border-radius:10px;border:1px solid #e5e7eb;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:44px;height:44px;background:#fffbeb;border-radius:10px;
                                display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-building"
                           style="font-size:1.2rem;color:#f59e0b;"></i>
                    </div>
                    <div>
                        <p style="margin:0;font-weight:600;font-size:1rem;">@Model.Name</p>
                        <p style="margin:0;font-size:0.85rem;color:#6b7280;">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Location
                        </p>
                        @if (Model.Description != null)
                        {
                            <p style="margin:0.25rem 0 0;font-size:0.82rem;color:#9ca3af;">
                                @Model.Description
                            </p>
                        }
                    </div>
                </div>
            </div>

            <form asp-controller="Facility" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn px-4"
                            style="background:#ef4444;color:white;border:none;
                                   border-radius:8px;font-weight:600;
                                   padding:0.5rem 1.25rem;">
                        <i class="bi bi-trash me-2"></i>Yes, Delete
                    </button>
                    <a asp-controller="Facility"
                       asp-action="Index"
                       class="btn btn-fp-outline px-4">Cancel</a>
                </div>
            </form>

        </div>
    </div>
</div>