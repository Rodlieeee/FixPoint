@{
    ViewData["Title"] = "Home";
}

<div class="fp-hero text-center">
    <div style="position:relative;z-index:1">
        <span style="background:rgba(245,158,11,0.15);color:#f59e0b;padding:0.4rem 1rem;border-radius:20px;font-size:0.8rem;font-weight:600;letter-spacing:0.05em;">
            FACILITY MAINTENANCE SYSTEM
        </span>
        <h1 class="mt-3 mb-2" style="font-size:2.5rem;font-weight:700;">
            Keep Everything <span style="color:#f59e0b;">Running</span>
        </h1>
        <p class="mb-4" style="color:#9ca3af;font-size:1.05rem;max-width:500px;margin:0 auto 1.5rem;">
            Report issues, track repairs, and manage your facilities — all in one place.
        </p>
        @if (!User.Identity.IsAuthenticated)
        {
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-fp-primary px-4 py-2">
                    <i class="bi bi-person-plus me-2"></i>Get Started
                </a>
                <a asp-area="Identity" asp-page="/Account/Login"
                   style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);color:white;border-radius:8px;padding:0.5rem 1.5rem;text-decoration:none;font-weight:500;transition:all 0.2s;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </a>
            </div>
        }
        else
        {
            @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
            {
                <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-fp-primary px-4 py-2">
                    <i class="bi bi-eye me-2"></i>See Requests
                </a>
            }
            else
            {
                <a asp-controller="MaintenanceRequest" asp-action="Create" class="btn btn-fp-primary px-4 py-2">
                    <i class="bi bi-plus-circle me-2"></i>Submit a Request
                </a>
            }
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="fp-card text-center h-100">
            <div style="width:52px;height:52px;background:#fffbeb;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <i class="bi bi-send-check" style="font-size:1.4rem;color:#f59e0b;"></i>
            </div>
            <h5 class="fw-700 mb-2">Track Requests</h5>
            <p class="text-muted mb-0" style="font-size:0.9rem;">Quickly check any active maintenance issue across all your facilities.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fp-card text-center h-100">
            <div style="width:52px;height:52px;background:#f0fdf4;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <i class="bi bi-person-gear" style="font-size:1.4rem;color:#10b981;"></i>
            </div>
            <h5 class="fw-700 mb-2">Assign Technicians</h5>
            <p class="text-muted mb-0" style="font-size:0.9rem;">Admins assign the right people to get jobs done efficiently.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fp-card text-center h-100">
            <div style="width:52px;height:52px;background:#eff6ff;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                <i class="bi bi-bar-chart-line" style="font-size:1.4rem;color:#3b82f6;"></i>
            </div>
            <h5 class="fw-700 mb-2">Track Progress</h5>
            <p class="text-muted mb-0" style="font-size:0.9rem;">Monitor every request from Open to Resolved in real time.</p>
        </div>
    </div>
</div>